{
  // Type-checks the factory: `pnpm typecheck` runs it through turbo, as for
  // the apps. Nothing is emitted; tsx and `node --test` run the .mts files.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Node runs the tests by stripping the types, so only erasable syntax.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["**/*.mts", "../.factory/*.mts"],
  "exclude": ["node_modules", "worktrees", "logs"]
}
