# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Read at runtime by the storefront server. The production container sets these
# instead of the NEXT_PUBLIC_* values in this file, which are baked in at build.
# Leave empty for `pnpm dev`.
# MEDUSA_BACKEND_URL is the backend as seen from the storefront server, and
# PUBLIC_MEDUSA_BACKEND_URL the backend as seen from the browser.
MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=
PUBLIC_MEDUSA_BACKEND_URL=
PUBLIC_BASE_URL=
PUBLIC_STRIPE_KEY=

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=pl

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe test-mode publishable key (pk_test_...), from the same account as the backend's STRIPE_API_KEY
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development

# Lets search engines and AI assistants index the store (ADR 0007).
# Only the exact value "true" turns indexing on; anything else, or leaving it
# empty, keeps crawlers out. Set it to true only on the real production store,
# never on the Railway test store or locally.
ALLOW_INDEXING=
