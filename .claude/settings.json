{
  "enabledPlugins": {
    "medusa-dev@medusa": true,
    "ecommerce-storefront@medusa": true
  },
  "extraKnownMarketplaces": {
    "medusa": {
      "source": {
        "source": "github",
        "repo": "medusajs/medusa-agent-skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ]
  }
}
