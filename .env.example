# Docker Compose stack (compose.yaml). Copy to .env and fill in the secrets:
#   cp .env.example .env
# Steps and checks: docs/runbooks/compose-stack.md. For `pnpm dev` use
# apps/backend/.env and apps/storefront/.env.local instead.

# Host ports for the Medusa server (Admin, Store API) and the storefront, bound
# to 127.0.0.1. Pick others if `pnpm dev` is using 9000 and 8000, then run
# `docker compose up -d --wait`.
MEDUSA_PORT=9000
STOREFRONT_PORT=8000

# Required. Letters and digits only, it goes into the database URL:
#   openssl rand -hex 16
POSTGRES_PASSWORD=
# Required. Generate each with `openssl rand -hex 32`, a different value for each.
JWT_SECRET=
COOKIE_SECRET=
# Required. The agent's and the model proxy's (LiteLLM's) database roles, created by the
# agent-db-setup service. Letters and digits only, a different value for each:
#   openssl rand -hex 16
AGENT_DB_PASSWORD=
LITELLM_DB_PASSWORD=
# Only needed for Admin two-factor login (TOTP MFA). openssl rand -hex 32
AUTH_MFA_ENCRYPTION_KEY=
# The agent's secret for Medusa's support routes (the commerce port). Not an admin key.
# Without it, or shorter than 32 characters, the routes refuse every call. openssl rand -hex 32
AGENT_SUPPORT_SECRET=
# Required. The storefront server's secret for the agent's case endpoints, and the
# key that signs the chat's case cookie. Each at least 32 characters, a different
# value for each: openssl rand -hex 32
AGENT_STOREFRONT_SECRET=
CHAT_COOKIE_SECRET=

# Cloudflare Turnstile on the chat's first message. Leave empty: the stack uses
# Cloudflare's test keys, which always pass. Never commit a real key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The chat's rate limit by IP. Empty means the starting values: 20 messages per
# 300 seconds and 5 new support cases per 3600 seconds.
CHAT_MESSAGE_LIMIT=
CHAT_MESSAGE_WINDOW_SECONDS=
CHAT_NEW_CASE_LIMIT=
CHAT_NEW_CASE_WINDOW_SECONDS=

# Created by `docker compose run --rm medusa-admin-user`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Stripe test mode only (sk_test_... and pk_test_...). Never a live key.
# Without them the store runs with the manual system payment only.
# STRIPE_WEBHOOK_SECRET is the whsec_... that `stripe listen` prints.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# The storefront reads it at start: `docker compose up -d --wait` after a change.
PUBLIC_STRIPE_KEY=

# Leave empty. The storefront reads the key the migration created.
MEDUSA_PUBLISHABLE_KEY=

# Leave empty: the store sends noindex and a robots.txt that blocks all crawlers
# (ADR 0007). Only the exact value "true" lets crawlers in, and only the real
# production store sets it. The storefront reads it at start.
ALLOW_INDEXING=

# Pulled into the ollama volume by `docker compose run --rm ollama-pull`.
OLLAMA_MODEL=
