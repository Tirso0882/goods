# Docker Compose stack (compose.yaml). Copy to .env and fill in the secrets:
#   cp .env.example .env
# Steps and checks: docs/runbooks/compose-stack.md. For `pnpm dev` use
# apps/backend/.env and apps/storefront/.env.local instead.

# Host ports for the Medusa server (Admin, Store API) and the storefront, bound
# to 127.0.0.1. Pick others if `pnpm dev` is using 9000 and 8000, then run
# `docker compose up -d --wait`.
MEDUSA_PORT=9000
STOREFRONT_PORT=8000

# Required. Letters and digits only, it goes into the database URL:
#   openssl rand -hex 16
POSTGRES_PASSWORD=
# Required. Generate each with `openssl rand -hex 32`, a different value for each.
JWT_SECRET=
COOKIE_SECRET=
# Only needed for Admin two-factor login (TOTP MFA). openssl rand -hex 32
AUTH_MFA_ENCRYPTION_KEY=

# Created by `docker compose run --rm medusa-admin-user`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Stripe test mode only (sk_test_... and pk_test_...). Never a live key.
# Without them the store runs with the manual system payment only.
# STRIPE_WEBHOOK_SECRET is the whsec_... that `stripe listen` prints.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# The storefront reads it at start: `docker compose up -d --wait` after a change.
PUBLIC_STRIPE_KEY=

# Leave empty. The storefront reads the key the migration created.
MEDUSA_PUBLISHABLE_KEY=

# Leave empty: the store sends noindex and a robots.txt that blocks all crawlers
# (ADR 0007). Only the exact value "true" lets crawlers in, and only the real
# production store sets it. The storefront reads it at start.
ALLOW_INDEXING=

# Pulled into the ollama volume by `docker compose run --rm ollama-pull`. The
# roadmap model (2.8 GB). On a slow machine use qwen3:0.6b (about 520 MB).
OLLAMA_MODEL=nemotron-3-nano:4b
