{
  "name": "goods",
  "private": false,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "reset": "bash scripts/reset-local-data.sh",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0",
      "@graphql-tools/utils@<12.0.2": "^12.0.2",
      "ajv@>=8 <8.18.0": "^8.18.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "glob@>=13 <14.0.2": "^14.0.2",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "lodash@<4.18.1": "^4.18.1",
      "minimatch@>=10 <11.0.1": "^11.0.1",
      "postcss@<8.5.32": "^8.5.32",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "uuid@<11.1.1": "^11.1.1"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.11.10"
  }
}
